{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "mem-plane", "args": ["hook", "session-start"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "mem-plane", "args": ["hook", "post-tool-use"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "mem-plane", "args": ["hook", "stop"], "async": true }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "mem-plane", "args": ["hook", "pre-compact"], "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "mem-plane", "args": ["hook", "session-end"], "async": true }
        ]
      }
    ]
  }
}
